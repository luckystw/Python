   "source": [
    "def factorial(n):\n",
    "    if n < 0:\n",
    "        print(\"Error: factorial is not defined for negative numbers.\")\n",
    "        return None\n",
    "    if n == 0 or n == 1:\n",
    "        return 1\n",
    "    return n * factorial(n - 1)\n",
    "\n",
    "print(factorial(5)) \n",
    "print(factorial(0))  \n",
    "print(factorial(-3))  "
   ]
  },
