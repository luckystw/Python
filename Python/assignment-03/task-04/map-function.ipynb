   "source": [
    "gst = lambda price: price + (0.18 * price)\n",
    "\n",
    "prices = [100, 250, 400, 1200, 50]\n",
    "\n",
    "prices_with_gst = list(map(gst, prices))\n",
    "\n",
    "print(\"Original prices:\", prices)\n",
    "print(\"Prices after GST:\", prices_with_gst)"
   ]
  },
