   "source": [
    "def apply_discount(price, discount_percent=5):\n",
    "    if discount_percent > 60:\n",
    "        discount_percent = 60\n",
    "    return price - (price * discount_percent / 100)\n",
    "\n",
    "\n",
    "print(apply_discount(1000, 10))   \n",
    "print(apply_discount(500))      \n",
    "print(apply_discount(200, 80))  "
   ]
  },
