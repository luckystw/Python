   "source": [
    "gst = lambda price: price + (0.18 * price)\n",
    "\n",
    "final_price = lambda price, discount_percent: gst(price - (price * discount_percent / 100))\n",
    "\n",
    "print(gst(100))\n",
    "print(gst(500))\n",
    "print(final_price(1000, 10))"
   ]
