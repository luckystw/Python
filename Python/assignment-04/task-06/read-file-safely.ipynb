   "source": [
    "import os\n",
    "\n",
    "filename = input(\"Enter filename to open: \")\n",
    "\n",
    "if os.path.exists(filename):\n",
    "    file = open(filename, \"r\")\n",
    "    print(file.read())\n",
    "    file.close()\n",
    "else:\n",
    "    print(\"File not found. Please check the filename.\")"
   ]
