    "import numpy as np\n",
    "\n",
    "values = np.array([2, 4, 6, 8, 10])\n",
    "\n",
    "print(\"Square root:\", np.sqrt(values))\n",
    "print(\"Exponential:\", np.exp(values))\n",
    "print(\"Natural log:\", np.log(values))\n",
    "print(\"Sum:\", np.sum(values))\n",
    "print(\"Cumulative sum:\", np.cumsum(values))"
